{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/book", "destination": "/ensembles", "permanent": true },
    { "source": "/book-event", "destination": "/events", "permanent": true },
    { "source": "/event-bookings", "destination": "/events", "permanent": true },
    { "source": "/meet-the-team", "destination": "/team", "permanent": true },
    { "source": "/la", "destination": "/los-angeles", "permanent": true },
    { "source": "/contact-8", "destination": "/contact", "permanent": true },
    { "source": "/bio", "destination": "/team", "permanent": true },
    { "source": "/alexanders-bio", "destination": "/team", "permanent": true },
    { "source": "/alexander-xhoja", "destination": "/team", "permanent": true },
    { "source": "/biography", "destination": "/team", "permanent": true },
    { "source": "/biography/:path*", "destination": "/team", "permanent": true },
    { "source": "/instructors", "destination": "/", "permanent": true },
    { "source": "/copy-of-instructors", "destination": "/", "permanent": true },
    { "source": "/copy-of-base-lessons-1", "destination": "/", "permanent": true },
    { "source": "/copy-of-drum-lessons", "destination": "/", "permanent": true },
    { "source": "/pricing-plans", "destination": "/", "permanent": true },
    { "source": "/pricing-plans/:path*", "destination": "/", "permanent": true },
    { "source": "/piano-lessons", "destination": "/", "permanent": true },
    { "source": "/guitar-lessons", "destination": "/", "permanent": true },
    { "source": "/drum-lessons", "destination": "/", "permanent": true },
    { "source": "/vocal-lessons", "destination": "/", "permanent": true },
    { "source": "/trumpet-lessons", "destination": "/", "permanent": true },
    { "source": "/clarinet-lessons", "destination": "/", "permanent": true },
    { "source": "/music-lessons", "destination": "/", "permanent": true },
    { "source": "/service-page/:path*", "destination": "/", "permanent": true },
    { "source": "/challenge-page/:path*", "destination": "/", "permanent": true },
    { "source": "/alex-piano-lessons/:path*", "destination": "/", "permanent": true },
    { "source": "/clarinet-booking-page/:path*", "destination": "/", "permanent": true },
    { "source": "/copy-of-piano-lessons-item", "destination": "/", "permanent": true },
    { "source": "/copy-of-guitar-lessons", "destination": "/", "permanent": true },
    { "source": "/blank-2", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-CqBkMBOB/67U0AvKucyqQf833/WhM/aOeyWcl82ra3U=' 'sha256-qFzpcnUUMEsT8doRWT0QaXa/pDj466/uo5XtdsDp/iY=' https://www.googletagmanager.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com https://*.google-analytics.com https://*.googletagmanager.com https://analytics.google.com https://*.g.doubleclick.net https://www.google.com; media-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://api.emailjs.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://analytics.google.com https://*.g.doubleclick.net https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
